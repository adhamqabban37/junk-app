# Database
# Connects as the non-superuser app role (see docker/postgres-init/01-app-role.sql) —
# never the POSTGRES_USER bootstrap superuser, which Postgres always exempts from RLS.
DATABASE_URL=postgres://junkyard_app:junkyard_app_dev@localhost:5432/junkyard_dev

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-dev
JWT_EXPIRES_IN=30d

# AI
GEMINI_API_KEY=

# NHTSA VIN decoding is a free, unauthenticated API — no key required
